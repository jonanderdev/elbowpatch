{
  "name": "elbowpatch-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/domain/tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:long": "E2E_LONG=1 playwright test pdf-long --project=chromium-desktop --project=webkit-desktop --project=firefox-desktop --workers=1",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "preact": "^11.1.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "fake-indexeddb": "^6.2.6",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
