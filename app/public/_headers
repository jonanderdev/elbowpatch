# Keep the site out of search engines while it is unfinished.
# Delete this rule at v1 to allow indexing, and keep the one below (docs/decisions/0016).
/*
  X-Robots-Tag: noindex, nofollow

# Built files carry their content's hash in their name, so a copy never goes stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
